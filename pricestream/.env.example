DEBUG=1
SECRET_KEY=change-me
CRYPTOGRAPHY_KEY=change-me-generate-with-Fernet.generate_key
ALLOWED_HOSTS=127.0.0.1,localhost,marketmantra.tech
# Served under marketmantra.tech/pricestream (path prefix, not a subdomain) — leave
# blank for local dev where the app runs at the domain root.
FORCE_SCRIPT_NAME=

DB_NAME=pricestream
DB_USER=pricestream
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SOCKS_PROXY_USER=
SOCKS_PROXY_PASS=

TICK_BATCH_SIZE=500
TICK_BATCH_FLUSH_SECONDS=2.0
WS_HEALTH_CHECK_INTERVAL=5
MARKET_HOURS_SUPERVISOR_INTERVAL_MINUTES=1
TICK_SILENCE_THRESHOLD_SECONDS=120

LOG_LEVEL=INFO
